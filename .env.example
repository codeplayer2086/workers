# Server Port & Runtime
PORT=3000
NODE_ENV="production"
APP_URL="https://your-domain.com"

# Session signing secret (set a long random string on your server)
SESSION_SECRET="change-me-to-a-long-random-secret"

# MySQL / MariaDB Database (use EITHER DATABASE_URL/MYSQL_URL OR the MYSQL_* fields below)
# Hostinger Unlimited uses MySQL / MariaDB on 127.0.0.1:3306
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="your_mysql_user"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="your_mysql_database"
# MYSQL_SSL="false"
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/maktab_placement"

# Optional persistent directory for private photos & compliance scans
# On Hostinger or VPS, point this outside the git/release folder so redeployments keep uploads
UPLOAD_DIR="./private_uploads"

# Optional: Gemini API Key for automatic English -> Arabic translation of worker notes & names
# If omitted, built-in deterministic Arabic transliteration fallback is used automatically.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Central WhatsApp Gateway (Evolution API compatible — single platform sender, no per-agent QR)
WHATSAPP_GATEWAY_URL="http://127.0.0.1:8080"
WHATSAPP_GATEWAY_API_KEY="your_whatsapp_gateway_api_key"
WHATSAPP_CENTRAL_INSTANCE="maktab_central"

